# Set these only in the server environment; never ship them in the client.
NEXERA_API_KEY=replace-with-a-long-random-secret
OPENROUTER_API_KEY=replace-with-your-openrouter-key
NEXERA_DEFAULT_MODEL=openrouter/auto
NEXERA_WORKSPACE_ROOT=/data/workspaces
NEXERA_CORS_ORIGINS=https://appassets.androidplatform.net,https://your-private-frontend.example
NEXERA_ENABLE_SANDBOX=false
NEXERA_MAX_TOOL_ROUNDS=8
NEXERA_MAX_OUTPUT_CHARS=18000
