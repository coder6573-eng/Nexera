{
  "name": "nexera-ai",
  "version": "12.0.0",
  "private": true,
  "description": "Nexera AI desktop app",
  "main": "desktop/main.cjs",
  "scripts": {
    "dist:win": "electron-builder --win portable",
    "test": "node scripts/check-inline-js.cjs && node scripts/test-ui.cjs && node scripts/test-workspace.cjs"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.1",
    "jsdom": "^31.0.0"
  },
  "build": {
    "appId": "ai.nexera.desktop",
    "productName": "Nexera AI",
    "asar": true,
    "files": [
      "desktop/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Nexera-AI-${version}.${ext}"
    },
    "artifactName": "Nexera-AI-${version}.${ext}"
  }
}
